# Supabase - proyecto
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Clave de servicio. Ignora RLS: solo se usa despues de verificar el rol
# en el servidor (el admin debe leer los archivos de todos los trabajadores).
SUPABASE_SERVICE_KEY=

# Management API. La API en ejecucion NO la usa: el modulo del trabajador
# opera contra funciones RPC desde el navegador. Estas dos variables son
# unicamente para scripts/db.mjs, que aplica las migraciones en desarrollo.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

PORT=4000
CLIENT_URL=http://localhost:5000

